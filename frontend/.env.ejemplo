# ============================================================
# Copie este archivo como `.env` y complete con los valores de
# su proyecto en https://supabase.com → Project Settings → API
# ============================================================

# URL del proyecto Supabase (la misma que usa el backend)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave PÚBLICA "anon" (esta SÍ puede vivir en el frontend;
# las políticas RLS limitan lo que puede hacer)
VITE_SUPABASE_ANON_KEY=coloque-aqui-la-clave-anon

# URL base de la API NestJS
VITE_API_URL=http://localhost:3000/api
