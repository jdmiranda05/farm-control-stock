# ============================================================
# Copie este archivo como `.env` y complete con los valores de
# su proyecto en https://supabase.com → Project Settings → API
# ============================================================

# URL del proyecto Supabase (ej. https://abcdefgh.supabase.co)
SUPABASE_URL=https://dwvkwawxmkxslyraafqc.supabase.co

# Clave "service_role" (SECRETA — solo vive en el backend, nunca en el frontend)
SUPABASE_SERVICE_ROLE_KEY=coloque-aqui-la-clave-service-role

# Puerto donde escucha la API
PUERTO=3000

# Origen permitido para CORS (URL del frontend en desarrollo)
ORIGEN_CORS=http://localhost:5173
